#!/usr/bin/env bash
set -euo pipefail

PACKAGE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJECT_DIR="$(pwd)"


TARGET_BASE="$PROJECT_DIR/.claude"
TYPES=(skills commands rules agents)

# По умолчанию — всё; флаг --select запускает интерактивный выбор
INTERACTIVE=false
if [[ "${1:-}" == "--select" ]] && [[ -t 0 ]]; then
    INTERACTIVE=true
fi

# Возвращает список поддиректорий
list_subdirs() {
    local dir="$1"
    find "$dir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort
}

# Интерактивный выбор из списка; выбранные элементы — в массиве SELECTED
prompt_multiselect() {
    local label="$1"
    shift
    local items=("$@")
    SELECTED=()

    echo ""
    echo "$label:"
    for i in "${!items[@]}"; do
        printf "  [%d] %s\n" "$((i + 1))" "${items[$i]}"
    done
    echo "  [a] Все"
    echo "  [0] Пропустить"
    printf "Выбор (например: 1 3 или a): "

    read -r input

    if [[ "$input" == "a" || "$input" == "A" ]]; then
        SELECTED=("${items[@]}")
        return
    fi

    if [[ "$input" == "0" || -z "$input" ]]; then
        return
    fi

    for part in $input; do
        if [[ "$part" =~ ^[0-9]+$ ]]; then
            idx=$((part - 1))
            if [[ $idx -ge 0 && $idx -lt ${#items[@]} ]]; then
                SELECTED+=("${items[$idx]}")
            fi
        fi
    done
}

copy_dir() {
    local src="$1"
    local dst="$2"
    mkdir -p "$dst"
    cp -r "$src/." "$dst/"
}

echo "=== sync-prompts ==="

# Собираем доступные типы
available_types=()
for type in "${TYPES[@]}"; do
    [[ -d "$PACKAGE_DIR/$type" ]] && available_types+=("$type")
done

if [[ ${#available_types[@]} -eq 0 ]]; then
    echo "sync-prompts: no content found in package."
    exit 0
fi

# Выбор типов
if [[ "$INTERACTIVE" == true ]]; then
    prompt_multiselect "Типы для установки" "${available_types[@]}"
    selected_types=("${SELECTED[@]}")
else
    selected_types=("${available_types[@]}")
fi

if [[ ${#selected_types[@]} -eq 0 ]]; then
    echo "Ничего не выбрано."
    exit 0
fi

echo ""

for type in "${selected_types[@]}"; do
    type_src="$PACKAGE_DIR/$type"

    mapfile -t categories < <(list_subdirs "$type_src")

    if [[ ${#categories[@]} -eq 0 ]]; then
        continue
    fi

    if [[ "$INTERACTIVE" == true ]]; then
        prompt_multiselect "$type/ — категории" "${categories[@]}"
        selected_categories=("${SELECTED[@]}")
    else
        selected_categories=("${categories[@]}")
    fi

    for category in "${selected_categories[@]}"; do
        copy_dir "$type_src/$category" "$TARGET_BASE/$type/$category"
        echo "  ✓ .claude/$type/$category"
    done
done

echo ""
echo "Готово."
